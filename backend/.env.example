# Server Configuration
PORT=5000
NODE_ENV=development

# Firebase Configuration
# For production: Set GOOGLE_APPLICATION_CREDENTIALS to path of your service account key
# For development: You can use the serviceAccountKey.json file
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# CORS Configuration
# For production: Set to your frontend domain
# For development: Use http://localhost:5173 or your Vite dev server
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Session Configuration
SESSION_TIMEOUT_MS=1800000
RECONNECT_GRACE_PERIOD_MS=30000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
